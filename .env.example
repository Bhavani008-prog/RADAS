# ==============================================================================
# Road Accident Data Analysis System (RADAS) - Environment Variables Template
# Copy this file to .env for local development: cp .env.example .env
# For Railway deployment, configure these in Railway's "Variables" dashboard tab.
# ==============================================================================

# Flask Session & Security Key (use a strong random string)
FLASK_SECRET_KEY=change-this-to-a-secure-random-secret-key

# MySQL Database Configuration (Local / Generic)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=road_accident_db

# Railway MySQL Plugin Variables (Railway automatically provides these when you add MySQL)
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQL_URL=

# Default Admin Credentials (initialized automatically on first boot if users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# Server Port (Railway automatically sets PORT)
PORT=5000

